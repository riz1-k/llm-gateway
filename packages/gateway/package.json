{
  "name": "switchyard-gateway",
  "version": "0.1.0",
  "description": "OpenAI-compatible LLM gateway: routing, fallback, circuit breaking, exact + semantic caching, rate limits, budgets and per-team cost tracking. Library (Hono) + CLI.",
  "keywords": [
    "llm",
    "llm-gateway",
    "ai-gateway",
    "openai",
    "openai-compatible",
    "anthropic",
    "proxy",
    "router",
    "fallback",
    "circuit-breaker",
    "rate-limit",
    "budget",
    "cost-tracking",
    "semantic-cache",
    "hono",
    "prometheus"
  ],
  "homepage": "https://github.com/riz1-k/llm-gateway#readme",
  "bugs": {
    "url": "https://github.com/riz1-k/llm-gateway/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riz1-k/llm-gateway.git",
    "directory": "packages/gateway"
  },
  "license": "MIT",
  "author": "riz1-k",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "switchyard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock-provider": {
      "types": "./dist/mock-provider.d.ts",
      "default": "./dist/mock-provider.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "drizzle/*.sql",
    "drizzle/meta/_journal.json",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts serve --config ../../config/gateway.local.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "SWITCHYARD_LIVE=1 vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "schema": "tsx scripts/config-schema.ts && tsx scripts/config-docs.ts",
    "schema:check": "tsx scripts/config-schema.ts --check && tsx scripts/config-docs.ts --check",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "ioredis": "6.0.0",
    "js-tiktoken": "1.0.21",
    "nanoid": "6.0.2",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "prom-client": "15.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@switchyard/mock-provider": "workspace:*",
    "drizzle-kit": "0.31.11",
    "openai": "7.45.0",
    "pino-pretty": "13.2.0",
    "tsdown": "0.23.2"
  }
}
