# Optional overrides for deploy/docker/docker-compose.yml — copy to deploy/docker/.env (gitignored).
# The defaults in the compose file are for a local, loopback-only demo stack; change them
# before exposing anything beyond 127.0.0.1.
# SWITCHYARD_IMAGE=switchyard:dev
# SWITCHYARD_ADMIN_TOKEN=
# POSTGRES_PASSWORD=
# GRAFANA_PG_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=
# LOG_LEVEL=info
# Host ports (all bound to 127.0.0.1)
# GATEWAY_PORT=8797
# POSTGRES_PORT=55432
# REDIS_PORT=56379
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3301
# TEMPO_PORT=3201
# TEMPO_OTLP_PORT=4319
# Tracing: the gateway exports to Tempo unless this is false
# SWITCHYARD_OTEL_ENABLED=true
