# Copy to .env (gitignored). `make dev` / `make test-live` / scripts/dev.sh source it
# (override the path with ENV_FILE=… for make, SWITCHYARD_ENV_FILE=… for scripts/dev.sh).
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
SWITCHYARD_ADMIN_TOKEN=sk-sy-dev-admin
# Optional overrides of the static dev keys
# DOCSQA_GATEWAY_KEY=sk-sy-dev-docsqa
# OPSAGENT_GATEWAY_KEY=sk-sy-dev-opsagent
# EVALS_GATEWAY_KEY=sk-sy-dev-evals
# Optional native providers (enabled only when set)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# PORT=8787
# LOG_LEVEL=info
