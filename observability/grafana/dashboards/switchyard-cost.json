    {
      "type": "stat",
      "title": "Projected month spend",
      "description": "Linear projection of month-to-date spend to the end of the UTC month.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (coalesce(sum(cost_usd), 0)\n  / greatest(extract(epoch FROM now() - date_trunc('month', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc')\n  / extract(epoch FROM (date_trunc('month', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc' + interval '1 month') - date_trunc('month', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc'), 0.01))::float8 AS \"Projected\"\n  FROM usage_daily\n  WHERE day >= date_trunc('month', now() AT TIME ZONE 'utc')::date AND team IN (${team:sqlstring})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "0",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
