    {
      "type": "stat",
      "title": "Month-to-date spend",
      "description": "Postgres rollups (authoritative).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0)::float8 AS \"MTD\"\n  FROM usage_daily\n  WHERE day >= date_trunc('month', now() AT TIME ZONE 'utc')::date AND team IN (${team:sqlstring})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "noValue": "0",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
