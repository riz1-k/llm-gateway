    {
      "type": "timeseries",
      "title": "Cumulative month-to-date spend by team",
      "description": "Running total since the start of the UTC month (usage_events).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgds}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH buckets AS (\n  SELECT date_bin(make_interval(secs => $__interval_ms / 1000.0), ts, TIMESTAMPTZ '2000-01-01') AS time,\n  team, sum(cost_usd) AS cost\n  FROM usage_events\n  WHERE ts >= date_trunc('month', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc' AND ts <= $__timeTo() AND team IN (${team:sqlstring})\n  GROUP BY 1, 2)\n  SELECT time, team AS metric,\n  (sum(cost) OVER (PARTITION BY team ORDER BY time))::float8 AS value\n  FROM buckets WHERE time >= $__timeFrom() ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "lineInterpolation": "smooth"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
