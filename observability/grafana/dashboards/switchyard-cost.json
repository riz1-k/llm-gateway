    {
      "type": "table",
      "title": "Budgets — month / day to date",
      "description": "Postgres: budget definitions vs rollup spend, with a linear end-of-period projection.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${pgds}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${pgds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT t.slug AS \"Team\", b.period::text AS \"Period\", b.action::text AS \"Action\",\n  b.limit_usd::float8 AS \"Limit\",\n  coalesce(s.spent, 0)::float8 AS \"Spent\",\n  (coalesce(s.spent, 0) / nullif(b.limit_usd, 0))::float8 AS \"Utilization\",\n  (coalesce(s.spent, 0) / greatest(\n  extract(epoch FROM now() - p.start) / extract(epoch FROM p.finish - p.start), 0.01))::float8 AS \"Projected\"\n  FROM teams t\n  JOIN budgets b ON b.team_id = t.id\n  CROSS JOIN LATERAL (\n  SELECT CASE WHEN b.period::text = 'monthly' THEN date_trunc('month', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc'\n  ELSE date_trunc('day', now() AT TIME ZONE 'utc') AT TIME ZONE 'utc' END AS start) p0\n  CROSS JOIN LATERAL (\n  SELECT p0.start AS start,\n  p0.start + CASE WHEN b.period::text = 'monthly' THEN interval '1 month' ELSE interval '1 day' END AS finish) p\n  LEFT JOIN LATERAL (\n  SELECT sum(d.cost_usd) AS spent FROM usage_daily d\n  WHERE d.team = t.slug AND d.day >= (p.start AT TIME ZONE 'utc')::date) s ON true\n  WHERE t.deleted_at IS NULL AND t.slug IN (${team:sqlstring})\n  ORDER BY \"Utilization\" DESC NULLS LAST",
          "refId": "A"
        }
      ],
