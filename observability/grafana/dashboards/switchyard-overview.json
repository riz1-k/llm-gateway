          "editorMode": "code",
          "expr": "sum by (status) (rate(sy_requests_total{route=~\"$route\", status!~\"2..\"}[$__rate_interval])) / ignoring(status) group_left clamp_min(sum(rate(sy_requests_total{route=~\"$route\"}[$__rate_interval])), 1e-9)",
